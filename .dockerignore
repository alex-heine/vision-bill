# Ignore everything by default; re-include only what the Dockerfile COPYs.
*

# The Dockerfile itself
!Dockerfile

# Root config files the build reads
!pyproject.toml
!uv.lock
!alembic.ini

# Source trees
!alembic/
!alembic/**
!src
!src/**
!frontend
!frontend/**

# Frontend build artifacts are compiled inside the image; never ship host copies.
frontend/node_modules
frontend/node_modules/**
frontend/out
frontend/out/**
frontend/.svelte-kit
frontend/.svelte-kit/**

# The locally-synced SPA is rebuilt inside the image; never ship host copies.
src/vision_bill/static/*
