# Ignore everything by default; re-include only what the Dockerfile COPYs.
*

# The Dockerfile itself
!Dockerfile

# Entrypoint script (migrates, then execs the CMD)
!docker-entrypoint.sh

# Root config files the build reads
!pyproject.toml
!uv.lock
!alembic.ini
!requirements.txt
!gpclist.json

# Source trees
!alembic/
!alembic/**
!src
!src/**
!frontend
!frontend/**

# Scripts needed at build time (GPC import)
!scripts/
!scripts/**

# Frontend build artifacts are compiled inside the image; never ship host copies.
frontend/node_modules
frontend/node_modules/**
frontend/out
frontend/out/**
frontend/.svelte-kit
frontend/.svelte-kit/**

# The locally-synced SPA is rebuilt inside the image; never ship host copies.
src/vision_bill/static/*
