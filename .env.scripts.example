# Copy this file to .env.scripts. Make loads it before running supported tools
# in scripts/. Keep .env.scripts local: it may eventually contain credentials.

# Vision Bill API used by scripts/create_benchmark_run.py and by
# scripts/context_budget.py when it reads the current tag vocabulary.
VB_API_URL=http://127.0.0.1:8080
VB_APP_URL=http://127.0.0.1:8080
# Benchmarks require an admin account. Prefer entering these through ARGS or
# uncomment them only in the ignored .env.scripts file.
# VB_USERNAME=admin
# VB_PASSWORD=

# Local Ollama API. Receipt data must not be sent to a remote host.
OLLAMA_HOST=http://127.0.0.1:11434

# Optional PostgreSQL overrides for context_budget.py --db-sample.
# These host-side defaults match docker-compose.yml.
PG__USER=vision_bill
PG__PASSWORD=vision_bill
PG__DB=vision_bill
PG__HOST=127.0.0.1
PG__PORT=54321

# Owner/migration connection used only by `make db-configure-roles`. Keep the
# password in .env.scripts, never in this tracked example.
# MIGRATION_DATABASE_URL=postgresql://migration_user:password@127.0.0.1:54321/vision_bill
