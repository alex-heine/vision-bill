# ── Vision Bill — environment template ─────────────────────────────────────
# Copy to `.env` (and/or `.env.local`) and fill in the values. Settings use a
# nested `SECTION__FIELD` scheme (see src/vision_bill/config.py). On first run,
# resolved values initialize `/app/config/config.yaml`; process environment
# variables and dotenv values always override that YAML file. In Docker the
# YAML file is stored on the host at `./server_data/config`.

# ── API ────────────────────────────────────────────────────────────────────
API__PORT=8080
API__LOG_LEVEL=INFO

# ── Image / receipt storage ────────────────────────────────────────────────
# Absolute directories. In Docker these map to the ./uploads and ./uploads_tmp
# volumes; for a local run point them at paths inside your working tree.
IMAGES__SAVE_DIR=/app/uploads/
IMAGES__TMP_DIR=/app/uploads_tmp/
# When true, uploads are saved directly as verified (no manual review step).
IMAGES__BYPASS_REVIEW_DEFAULT=false

# ── Background analysis worker ─────────────────────────────────────────────
WORKER__CHECK_INTERVAL_SECONDS=300

# ── LLM (local Ollama) ─────────────────────────────────────────────────────
LLM__PROVIDER=ollama
LLM__HOST=localhost:11434
# A vision-capable model id available in your local Ollama.
LLM__MODEL_NAME=llama3:vision
LLM__TEMPERATURE=0.7
# api_key is only used by the (unsupported) external providers; keep a dummy.
LLM__API_KEY=none

# ── PostgreSQL ─────────────────────────────────────────────────────────────
PG__USER=vision_bill
PG__PASSWORD=vision_bill
PG__DB=vision_bill
PG__HOST=localhost
# 5432 inside Docker, 54321 when running the DB via `docker compose` on a host
# that maps 54321:5432.
PG__PORT=5432

# ── Authentication (multi-user) ────────────────────────────────────────────
# REQUIRED. Signs the stateless, HMAC session cookie. Use a long random string:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH__SECRET_KEY=

# Optional. Salts passwords before Argon2id hashing. When unset,
# AUTH__SECRET_KEY is used as the pepper, so a pepper is always in play.
# AUTH__PEPPER=

# First-boot admin, created idempotently only on a completely empty DB (and
# used to backfill legacy rows with no owner). Leave both unset to skip it and
# rely on registration instead.
# AUTH__BOOTSTRAP_USERNAME=admin
# AUTH__BOOTSTRAP_PASSWORD=

# Self-service registration from the login page (default: true). Set false to
# lock the app down to pre-provisioned accounts.
# AUTH__ALLOW_REGISTRATION=true

# When true, admins can view and edit every user's receipts and images
# (default: false — an admin sees only their own data).
# AUTH__ADMIN_CAN_SEE_ALL=false

# Set true when serving over HTTPS so the session cookie gets the Secure flag
# (default: false).
# AUTH__SESSION_SECURE=false

# Rarely changed (defaults shown):
# AUTH__SESSION_COOKIE_NAME=vb_session
# AUTH__SESSION_MAX_AGE_SECONDS=1209600
